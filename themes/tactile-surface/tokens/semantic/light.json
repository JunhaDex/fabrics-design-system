{
  "sem": {
    "color": {
      "$type": "color",
      "surface": {
        "$value": "{color.gray.100}"
      },
      "surface-raised": {
        "$value": "{color.gray.100}"
      },
      "surface-overlay": {
        "$value": "{color.gray.100}"
      },
      "surface-inverse": {
        "$value": "{color.gray.900}"
      },
      "on-surface-inverse": {
        "$value": "{color.gray.50}"
      },
      "field": {
        "$value": "{color.gray.100}"
      },
      "track": {
        "$value": "{color.gray.300}"
      },
      "on-surface": {
        "$value": "{color.gray.800}"
      },
      "on-surface-muted": {
        "$value": "{color.gray.600}"
      },
      "brand": {
        "$value": "{color.blue.600}"
      },
      "brand-hover": {
        "$value": "{color.blue.700}"
      },
      "on-brand": {
        "$value": "{color.white}"
      },
      "brand-subtle": {
        "$value": "{color.blue.50}"
      },
      "on-brand-subtle": {
        "$value": "{color.blue.700}"
      },
      "border": {
        "$value": "{color.gray.200}"
      },
      "border-strong": {
        "$value": "{color.gray.300}"
      },
      "border-field": {
        "$value": "{color.gray.500}"
      },
      "ring": {
        "$value": "{color.blue.500}"
      },
      "danger": {
        "$value": "{color.red.700}"
      },
      "on-danger": {
        "$value": "{color.white}"
      },
      "success": {
        "$value": "{color.green.700}"
      },
      "on-success": {
        "$value": "{color.white}"
      },
      "warning": {
        "$value": "{color.amber.700}"
      },
      "on-warning": {
        "$value": "{color.white}"
      },
      "info": {
        "$value": "{color.blue.600}"
      },
      "on-info": {
        "$value": "{color.white}"
      },
      "neutral": {
        "$value": "{color.gray.700}"
      },
      "on-neutral": {
        "$value": "{color.white}"
      },
      "info-subtle": {
        "$value": "{color.blue.50}"
      },
      "on-info-subtle": {
        "$value": "{color.blue.700}"
      },
      "success-subtle": {
        "$value": "{color.green.50}"
      },
      "on-success-subtle": {
        "$value": "{color.green.700}"
      },
      "warning-subtle": {
        "$value": "{color.amber.50}"
      },
      "on-warning-subtle": {
        "$value": "{color.amber.700}"
      },
      "danger-subtle": {
        "$value": "{color.red.50}"
      },
      "on-danger-subtle": {
        "$value": "{color.red.700}"
      },
      "neutral-subtle": {
        "$value": "{color.gray.200}"
      },
      "on-neutral-subtle": {
        "$value": "{color.gray.700}"
      },
      "scrim": {
        "$value": "rgba(9, 9, 11, 0.5)"
      }
    },
    "shadow": {
      "$type": "shadow",
      "control": {
        "$value": [
          {
            "offsetX": "-4px",
            "offsetY": "-4px",
            "blur": "8px",
            "spread": "0px",
            "color": "{color.white}"
          },
          {
            "offsetX": "4px",
            "offsetY": "4px",
            "blur": "8px",
            "spread": "0px",
            "color": "rgba(0, 0, 0, 0.15)"
          }
        ]
      },
      "control-pressed": {
        "$value": [
          {
            "offsetX": "3px",
            "offsetY": "3px",
            "blur": "6px",
            "spread": "0px",
            "color": "rgba(0, 0, 0, 0.15)",
            "inset": true
          },
          {
            "offsetX": "-3px",
            "offsetY": "-3px",
            "blur": "6px",
            "spread": "0px",
            "color": "{color.white}",
            "inset": true
          }
        ]
      },
      "field": {
        "$value": [
          {
            "offsetX": "2px",
            "offsetY": "2px",
            "blur": "4px",
            "spread": "0px",
            "color": "rgba(0, 0, 0, 0.15)",
            "inset": true
          },
          {
            "offsetX": "-2px",
            "offsetY": "-2px",
            "blur": "4px",
            "spread": "0px",
            "color": "{color.white}",
            "inset": true
          }
        ]
      },
      "raised": {
        "$value": [
          {
            "offsetX": "-6px",
            "offsetY": "-6px",
            "blur": "12px",
            "spread": "0px",
            "color": "{color.white}"
          },
          {
            "offsetX": "6px",
            "offsetY": "6px",
            "blur": "12px",
            "spread": "0px",
            "color": "rgba(0, 0, 0, 0.15)"
          }
        ]
      },
      "overlay": {
        "$value": [
          {
            "offsetX": "-8px",
            "offsetY": "-8px",
            "blur": "16px",
            "spread": "0px",
            "color": "{color.white}"
          },
          {
            "offsetX": "8px",
            "offsetY": "8px",
            "blur": "24px",
            "spread": "0px",
            "color": "rgba(0, 0, 0, 0.15)"
          }
        ]
      }
    }
  }
}
