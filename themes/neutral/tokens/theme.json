{
  "sem": {
    "radius": {
      "$type": "dimension",
      "control": {
        "$value": "{radius.md}"
      },
      "surface": {
        "$value": "{radius.lg}"
      }
    },
    "shadow": {
      "$type": "shadow",
      "raised": {
        "$value": "{shadow.sm}"
      },
      "overlay": {
        "$value": "{shadow.lg}"
      }
    },
    "spacing": {
      "$type": "dimension",
      "control-x": {
        "$value": "{spacing.3}"
      },
      "control-y": {
        "$value": "{spacing.2}"
      },
      "stack": {
        "$value": "{spacing.4}"
      },
      "field-gap": {
        "$value": "{spacing.2}"
      },
      "cell-x": {
        "$value": "{spacing.4}"
      },
      "cell-y": {
        "$value": "{spacing.2}"
      }
    },
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "{duration.instant}"
      },
      "base": {
        "$value": "{duration.quick}"
      },
      "slow": {
        "$value": "{duration.moderate}"
      }
    },
    "ease": {
      "$type": "cubicBezier",
      "standard": {
        "$value": "{ease.in-out}"
      },
      "enter": {
        "$value": "{ease.out}"
      },
      "exit": {
        "$value": "{ease.in}"
      }
    }
  }
}
